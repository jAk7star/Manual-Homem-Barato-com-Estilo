# ============================================================
# Elite Bot — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elitebot
POSTGRES_USER=elitebot_user
POSTGRES_PASSWORD=change_me_local

# ------------------------------------------------------------
# PostgREST
# ------------------------------------------------------------

# Connection string usada pelo PostgREST para conectar ao banco.
# Formato: postgres://user:password@host:port/db
PGRST_DB_URI=postgres://elitebot_user:change_me_local@postgres:5432/elitebot

# Schema exposto pela API REST
PGRST_DB_SCHEMA=public

# Role do PostgreSQL usada por requisições sem autenticação (leitura pública)
PGRST_DB_ANON_ROLE=web_anon

# Segredo JWT — mínimo 32 caracteres
# Gere com: openssl rand -base64 32
PGRST_JWT_SECRET=change_me_minimum_32_characters_secret

# ------------------------------------------------------------
# Worker
# ------------------------------------------------------------

# Connection string para o Worker conectar diretamente ao PostgreSQL
DATABASE_URL=postgres://elitebot_user:change_me_local@localhost:5432/elitebot

# URL base do PostgREST (usada pelo Worker para operações via API)
POSTGREST_URL=http://localhost:3000

# Mesmo segredo JWT usado pelo PostgREST
JWT_SECRET=change_me_minimum_32_characters_secret

# ------------------------------------------------------------
# pgAdmin (opcional — apenas com profile "tools")
# ------------------------------------------------------------

PGADMIN_EMAIL=admin@elitebot.local
PGADMIN_PASSWORD=admin

# ------------------------------------------------------------
# Canais de Notificação (Fase 6 — Multi-Provider)
# ------------------------------------------------------------

# WhatsApp — Evolution API / Z-API / Webhook
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_evolution
EVOLUTION_INSTANCE=instancia_elitebot

ZAPI_INSTANCE_ID=sua_instancia_zapi
ZAPI_TOKEN=seu_token_zapi

WHATSAPP_WEBHOOK_URL=https://webhook.site/seu-webhook-whatsapp

# Email — Resend / SendGrid / Webhook HTML
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL=Elite Bot <alertas@elitebot.com.br>

SENDGRID_API_KEY=SG.sua_chave_sendgrid
SENDGRID_FROM_EMAIL=alertas@elitebot.com.br

EMAIL_WEBHOOK_URL=https://webhook.site/seu-webhook-email

# Chrome Extension Push
PUSH_WEBHOOK_URL=https://webhook.site/seu-webhook-push

