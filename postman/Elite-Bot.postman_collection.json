{
	"info": {
		"_postman_id": "elitebot-collection-v1",
		"name": "Elite Bot — API Test Suite V1",
		"description": "Suíte completa de testes automatizados para validar a API REST PostgREST antes da integração com a Chrome Extension e Frontend.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "P0 — Leitura do Catálogo",
			"item": [
				{
					"name": "TC-P0-01 — Listar Categorias",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Retorna um array de categorias', function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body).to.be.an('array').with.length.gte(1);",
									"});",
									"pm.test('Armazena category_id no ambiente', function () {",
									"    const body = pm.response.json();",
									"    if (body.length > 0) {",
									"        pm.environment.set('category_id', body[0].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/categories",
							"host": ["{{base_url}}"],
							"path": ["categories"]
						}
					}
				},
				{
