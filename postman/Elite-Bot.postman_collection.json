		{
			"name": "SEC — Segurança e RLS",
			"item": [
				{
					"name": "TC-SEC-01 — Bloqueio de Escrita sem Auth",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Escrita pública sem autenticação é bloqueada (401/403/42501)', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Produto Não Autorizado\",\n  \"slug\": \"produto-nao-autorizado\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						}
