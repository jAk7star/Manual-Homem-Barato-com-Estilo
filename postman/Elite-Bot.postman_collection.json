							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Contém campos obrigatórios para a Extension', function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body).to.be.an('array').with.length.gte(1);",
									"    const first = body[0];",
									"    pm.expect(first).to.have.property('product_id');",
									"    pm.expect(first).to.have.property('offer_id');",
									"    pm.expect(first).to.have.property('store_name');",
									"    pm.expect(first).to.have.property('total_price');",
									"    pm.expect(first).to.have.property('product_url');",
									"});"
								],
