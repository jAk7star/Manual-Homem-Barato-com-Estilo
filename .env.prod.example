# ==========================================
# Elite Bot & OpenClaw — Production Environment (.env.prod)
# ==========================================

# 1. Domínios para SSL no Caddy (Substitua pelo seu domínio da Hostinger)
API_DOMAIN=api.seusite.com
REDIRECT_DOMAIN=click.seusite.com
OPENCLAW_DOMAIN=claw.seusite.com

# 2. Configurações do Banco de Dados PostgreSQL
POSTGRES_DB=elitebot
POSTGRES_USER=elitebot_user
POSTGRES_PASSWORD=SubstituaPorUmaSenhaMuitoForteEAleatoria123!
AUTHENTICATOR_PASSWORD=SubstituaPorOutraSenhaMuitoForteAuthenticator123!

# 3. PostgREST API Security (Usa a role 'authenticator' para respeitar o RLS)
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=web_anon
PGRST_JWT_SECRET=GerarSecretJWTComPeloMenos32CaracteresSeguros123!

# 4. URLs de Redirecionamento e Monetização
PUBLIC_REDIRECT_URL=https://click.seusite.com

# 5. Notificações Multi-Provedor (WhatsApp / E-mail / Push)
EVOLUTION_API_ENDPOINT=https://api.whatsapp-provider.com
EVOLUTION_API_KEY=sua-api-key-do-evolution
RESEND_API_KEY=re_123456789_sua_chave_resend
NOTIFICATION_EMAIL_FROM=alertas@seusite.com

# 6. Motor OpenClaw Engine
OPENCLAW_MODE=production
OPENCLAW_WORKERS=4
HEADLESS_BROWSER=true
